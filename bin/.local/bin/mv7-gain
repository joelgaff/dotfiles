#!/usr/bin/env bash
# Set the Shure MV7+'s mic gain, in dB (0 to 36). No argument shows it.
# The volume sliders on the laptop don't reach this; it lives inside the mic.
#
#   mv7-gain        show the current gain
#   mv7-gain 12     set it to +12 dB
set -euo pipefail

card=$(grep -l '^MV7' /proc/asound/card*/id 2>/dev/null | head -1 | grep -o 'card[0-9]*' | tr -dc 0-9) || true
[ -n "${card:-}" ] || { echo "MV7+ not plugged in" >&2; exit 1; }

if [ $# -eq 0 ]; then
  steps=$(amixer -c "$card" cget iface=MIXER,name='Microphone Capture Volume' | grep -o 'values=[0-9]*' | tr -dc 0-9)
  echo "MV7+ gain: +$((steps / 2)) dB"
else
  amixer -c "$card" cset iface=MIXER,name='Microphone Capture Volume' "$(( $1 * 2 ))" >/dev/null
  echo "MV7+ gain: +$1 dB"
fi
