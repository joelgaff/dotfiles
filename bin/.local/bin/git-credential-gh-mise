#!/bin/sh
# Git credential helper that defers to the GitHub CLI, whichever version mise
# currently has installed.
#
# Why this exists: pointing git at a versioned mise install path
# (~/.local/share/mise/installs/gh/<version>/...) breaks the next time mise
# upgrades gh, and pointing it at the mise shim breaks too, because the shim
# prints install banners on stdout and git reads that as credential data.
# MISE_QUIET=1 silences the banner; resolving gh at call time survives upgrades.
set -e
export MISE_QUIET=1

find_gh() {
    # Preferred: ask mise where the active gh lives.
    if command -v mise >/dev/null 2>&1; then
        gh=$(mise which gh 2>/dev/null || true)
        [ -n "$gh" ] && [ -x "$gh" ] && { printf '%s' "$gh"; return 0; }
    fi
    # Next: a gh on PATH that is not a mise shim (a shim would re-add noise).
    gh=$(command -v gh 2>/dev/null || true)
    if [ -n "$gh" ] && [ -x "$gh" ] && [ "${gh#*/mise/shims/}" = "$gh" ]; then
        printf '%s' "$gh"
        return 0
    fi
    # Last resort: newest mise install on disk.
    for gh in $(ls -1dt "$HOME"/.local/share/mise/installs/gh/*/gh_*/bin/gh 2>/dev/null); do
        [ -x "$gh" ] && { printf '%s' "$gh"; return 0; }
    done
    return 1
}

gh=$(find_gh) || {
    echo "git-credential-gh-mise: no usable gh binary found" >&2
    exit 1
}

exec "$gh" auth git-credential "$@"
