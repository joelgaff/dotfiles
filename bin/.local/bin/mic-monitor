#!/usr/bin/env bash
# Toggle hearing your own mic in your headphones (mic monitoring).
#
#   mic-monitor          toggle on/off
#   mic-monitor on|off   force a state
#   mic-monitor status
#
# Safety: only turns on when sound is going to headphones on the 3.5mm jack
# (speakers would feed back), starts at a modest level, and mutes the
# headphones for the moment it takes to start so nothing can burst.
set -euo pipefail

HEADPHONES="alsa_output.pci-0000_c1_00.6.HiFi__Headphones__sink"
LEVEL="${MIC_MONITOR_LEVEL:-55%}"  # monitoring level; the headphones' own volume is untouched
LATENCY_MS=1       # low enough not to echo, high enough not to glitch

notify() { notify-send -t 2500 "Mic monitoring" "$1" 2>/dev/null || true; echo "$1"; }
module() { pactl list modules short | awk '$2 == "module-loopback" && /mic-monitor/ {print $1}'; }

turn_off() {
  local ids; ids=$(module)
  [ -n "$ids" ] && for id in $ids; do pactl unload-module "$id"; done
  pw-metadata -n settings 0 clock.force-quantum 0 >/dev/null 2>&1   # back to the normal buffer
  notify "Off"
}

turn_on() {
  [ -n "$(module)" ] && { notify "Already on"; return; }
  # Headphones only: the wired ones on the 3.5mm jack, USB, or Bluetooth
  # headphones. Never the speakers (feedback).
  local sink; sink=$(pactl get-default-sink)
  case "$sink" in
    "$HEADPHONES") ;;
    # The MV7+ mixes its own mic into its headphone jack in hardware (no
    # delay). A loopback on top would be a second, late copy: an echo.
    alsa_output.usb-Shure_Inc_Shure_MV7*)
      notify "Not needed: headphones in the MV7+ hear the mic directly (no delay). Set the mix on the mic's touch panel or in the Shure MOTIV app."
      return ;;
    bluez_output.*) LATENCY_MS=30 ;;   # Bluetooth adds its own delay; 5 ms glitches
    alsa_output.usb-*) ;;              # USB headphones / USB-C audio adapter
    *) sink="" ;;
  esac
  if [ -z "$sink" ]; then
    notify "Not turned on: switch the output to headphones (wired, USB, or Bluetooth) first; speakers would feed back."
    exit 1
  fi
  local source; source=$(pactl get-default-source)
  # Mic FX adds delay (noise suppression works in chunks). Monitor the raw mic
  # behind it instead; apps still record the cleaned Mic FX input.
  if [ "$source" = "omarchy_mic_fx" ]; then
    local raw
    raw=$("$HOME/.config/omarchy/plugins/io.github.codemonkey76.micfx/omarchy-mic-fx" status 2>/dev/null \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["device"]["name"])' 2>/dev/null)
    [ -n "$raw" ] && source="$raw"
  fi
  # Smallest buffer while monitoring (~1.3 ms at 48 kHz) so you hear yourself
  # with as little delay as software allows; reset by "off".
  pw-metadata -n settings 0 clock.force-quantum 64 >/dev/null 2>&1
  pactl set-sink-mute "$sink" 1
  pactl load-module module-loopback source="$source" sink="$sink" \
    latency_msec="$LATENCY_MS" \
    "sink_input_properties='media.name=mic-monitor node.dont-reconnect=true node.dont-fallback=true'" \
    source_output_properties=media.name=mic-monitor >/dev/null
  sleep 0.3
  local input
  input=$(pactl list sink-inputs | awk '/^Sink Input #/ {id = substr($3, 2)} /media.name = "mic-monitor"/ {print id; exit}')
  # Unmute too: if the board's feedback guard muted a previous monitor stream,
  # PipeWire remembers that mute and would start this one silent.
  [ -n "$input" ] && pactl set-sink-input-volume "$input" "$LEVEL" && pactl set-sink-input-mute "$input" 0
  pactl set-sink-mute "$sink" 0
  notify "On"
}

case "${1:-toggle}" in
  on) turn_on ;;
  off) turn_off ;;
  status) [ -n "$(module)" ] && echo on || echo off ;;
  toggle) if [ -n "$(module)" ]; then turn_off; else turn_on; fi ;;
  *) echo "usage: mic-monitor [on|off|toggle|status]" >&2; exit 2 ;;
esac
