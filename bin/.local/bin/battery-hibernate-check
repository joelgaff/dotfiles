#!/bin/bash

# Hibernate when the battery is critically low, so an unattended machine saves
# the session to disk instead of dying with it.
#
# This used to hang off an ExecStartPost drop-in on omarchy-battery-monitor.service.
# Quattro moved battery monitoring into the shell and deleted that unit, which
# silently disabled the whole thing. battery-hibernate.timer drives it now, and
# it reads sysfs directly so no omarchy internals can move out from under it.

set -uo pipefail

threshold=${1:-3}

for dir in /sys/class/power_supply/BAT*; do
  [[ -r $dir/capacity && -r $dir/status ]] || continue
  battery=$dir
  break
done

[[ -n ${battery:-} ]] || exit 0

level=$(<"$battery/capacity")
state=$(<"$battery/status")

[[ $state == "Discharging" ]] || exit 0
[[ $level =~ ^[0-9]+$ ]] || exit 0
((level <= threshold)) || exit 0

notify-send -u critical "Battery ${level}% — hibernating now"
loginctl lock-session
sleep 1
systemctl hibernate
