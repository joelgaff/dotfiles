# Sensitive files
*.log
*.key
*.pem
*_history
.bash_history
.zsh_history

# SSH private keys, which carry no extension and so slip past *.key above.
# Nothing under .ssh is tracked today; this is here so that stays true if an
# ssh package is ever added. Public halves are explicitly allowed back.
id_*
!id_*.pub
*_ed25519
!*_ed25519.pub
*_rsa
!*_rsa.pub
git_signing
!git_signing.pub
known_hosts
allowed_signers

# Cache and temporary files
*.cache
*.tmp
*.swp
*~

# Package manager files that get auto-generated
lazy-lock.json
package-lock.json

# Numbered backups scattered by Omarchy upgrades and migrations
*.bak
*.bak.*

# Blip bridge shims — regenerated by blip-setup, hardcode per-machine paths
bin/imsg
bin/imsg-send
bin/imsg-read
bin/contacts
