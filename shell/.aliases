# Cross-platform shell aliases and functions.
# Sourced from .bashrc (Linux) and .zshrc (macOS).

alias het='ssh deploy@5.161.58.238'
alias gateway='ssh gateway'
alias t3='things3'
alias bcc='basecamp'
alias lg='lazygit'

# Dotfiles management
dots() {
  if [[ "$1" == "--help" ]]; then
    echo "Dotfiles commands:"
    echo "  dots          dotfiles - cd into ~/dotfiles"
    echo "  dots --help   show this menu"
    echo "  dotss         dotfiles status - git status"
    echo "  dotsc <msg>   dotfiles commit - git add all + commit with message"
    echo "  dotsp         dotfiles push - git push"
  else
    cd ~/dotfiles
  fi
}
dotsc() {
  local msg
  if [ $# -gt 0 ]; then
    msg="$*"
  else
    msg=$(_dotmsg)
    [ -z "$msg" ] && { echo "Nothing to commit."; return 1; }
    printf "Suggested: %s\nCommit with this message? [Y/n] " "$msg"
    read -r reply
    case "$reply" in
      n|N|no) echo "Aborted. Run: dotsc \"your message\""; return 1 ;;
    esac
  fi
  git -C ~/dotfiles add -A && git -C ~/dotfiles commit -m "$msg"
}

# Generate a commit message from current dotfiles changes.
_dotmsg() {
  local status count first_status first_file top topcount
  status=$(git -C ~/dotfiles status --porcelain 2>/dev/null)
  [ -z "$status" ] && return
  count=$(printf '%s\n' "$status" | wc -l | tr -d ' ')

  if [ "$count" -eq 1 ]; then
    first_status=$(printf '%s' "$status" | cut -c1-2)
    first_file=$(printf '%s' "$status" | cut -c4-)
    case "$first_status" in
      '??'|'A '|' A') echo "Add $first_file" ;;
      'D '|' D')      echo "Remove $first_file" ;;
      'R'*)           echo "Rename $first_file" ;;
      *)              echo "Update $first_file" ;;
    esac
  else
    top=$(printf '%s\n' "$status" | cut -c4- | awk -F/ '{print $1}' | sort -u)
    topcount=$(printf '%s\n' "$top" | wc -l | tr -d ' ')
    if [ "$topcount" -eq 1 ]; then
      echo "Update $top ($count files)"
    else
      local list
      list=$(printf '%s' "$top" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
      echo "Update $count files: $list"
    fi
  fi
}
alias dotss='git -C ~/dotfiles status'
alias dotsp='cd ~/dotfiles && git push'

# Report dotfiles push/pull/dirty state with fix hints. Silent when clean.
dotcheck() {
  [ -d ~/dotfiles/.git ] || return
  ( cd ~/dotfiles && git fetch -q 2>/dev/null
    local ahead behind dirty
    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null); ahead=${ahead:-0}
    behind=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null); behind=${behind:-0}
    dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' '); dirty=${dirty:-0}
    [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ] && [ "$dirty" -eq 0 ] && return

    # Bold + reverse video = guaranteed high-contrast on any terminal theme.
    local H="\033[1;7;33m"  # bold, reverse, yellow
    local B="\033[1;33m"    # bold yellow
    local R="\033[0m"       # reset
    printf "\n${H} ⚠  DOTFILES NEEDS ATTENTION ${R}\n"
    [ "$dirty"  -gt 0 ] && printf "${B}   • %s uncommitted change(s)${R}  →  ${B}dotsc${R} (auto-message)\n" "$dirty"
    [ "$ahead"  -gt 0 ] && printf "${B}   • %s commit(s) to push${R}       →  ${B}dotsp${R}\n" "$ahead"
    [ "$behind" -gt 0 ] && printf "${B}   • %s commit(s) to pull${R}       →  ${B}cd ~/dotfiles && git pull${R}\n" "$behind"
    printf "\n"
  )
}

# Run dotcheck at most once per day on shell startup.
if [ -z "$(find ~/.dotcheck-stamp -mtime -1 2>/dev/null)" ]; then
  dotcheck && touch ~/.dotcheck-stamp
fi
