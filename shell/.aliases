# Cross-platform shell aliases and functions.
# Sourced from .bashrc (Linux) and .zshrc (macOS).

alias het='ssh deploy@5.161.58.238'
alias gateway='ssh gateway'
alias t3='things3'
alias bcc='basecamp'
alias lg='lazygit'

# Dotfiles management
dots() {
  if [[ "$1" == "--help" ]]; then
    echo "Dotfiles commands:"
    echo "  dots          dotfiles - cd into ~/dotfiles"
    echo "  dots --help   show this menu"
    echo "  dotss         dotfiles status - git status"
    echo "  dotsc <msg>   dotfiles commit - git add all + commit with message"
    echo "  dotsp         dotfiles push - git push"
  else
    cd ~/dotfiles
  fi
}
dotsc() {
  cd ~/dotfiles && git add . && git commit -m "$*"
}
alias dotss='git -C ~/dotfiles status'
alias dotsp='cd ~/dotfiles && git push'

# Report dotfiles push/pull/dirty state. Silent when clean.
dotcheck() {
  [ -d ~/dotfiles/.git ] || return
  ( cd ~/dotfiles && git fetch -q 2>/dev/null
    local ahead behind dirty
    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null)
    behind=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null)
    dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    [ "${ahead:-0}"  -gt 0 ] && echo "dotfiles: $ahead commit(s) to push"
    [ "${behind:-0}" -gt 0 ] && echo "dotfiles: $behind commit(s) to pull"
    [ "${dirty:-0}"  -gt 0 ] && echo "dotfiles: $dirty uncommitted change(s)"
  )
}

# Run dotcheck at most once per day on shell startup.
if [ -z "$(find ~/.dotcheck-stamp -mtime -1 2>/dev/null)" ]; then
  dotcheck && touch ~/.dotcheck-stamp
fi
